<aura:component implements="flexipage:availableForAllPageTypes" access="global" >
<aura:attribute name="messageValue" type="String"/>
<aura:attribute name="messageReceived" type="String"/>
    <lightning:messageChannel type="SampleMessageChannel__c" 
          scope="APPLICATION"
          aura:id="sampleMessageChannel" 
          onMessage = "{!c.handleMessage}"
    />

    <lightning:card title="LMS Aura Component" iconName="custom:custom63">
        <div class="slds-m-around_medium">
            <label>Enter publish message</label>
            <input type="text" 
                    aura:id="messageInput" 
                    name="messageInput" 
                    class="slds-input"
                    value="{!v.messageValue}"
                    onkeyup="{!c.inputHandler}"
            />
          </div>
          <div class="slds-m-around_medium">
            <lightning:button label="Publish" variant="brand" onclick="{!c.publishMessage}"/>
            <lightning:button label="Unpublish" variant="brand" onclick="{!c.unSubscribeMessage}"/>
          </div>

        <div class="slds-m-around_medium">
            <p>The message received is <strong>{!v.messageReceived}</strong></p>
        </div>

    </lightning:card>

</aura:component>